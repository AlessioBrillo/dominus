# DOMINUS environment configuration
# Copy to .env and fill in values.
# Line numbering: 111 configurable parameters (Zod schema at src/config.ts).

# --- Core paths ---
# SQLite database path (community edition - default).
DATABASE_PATH=./data/dominus.db

# PostgreSQL connection string (DOMINUS Cloud edition).
# When set, overrides DATABASE_PATH and uses PostgreSQL instead of SQLite.
# Format: postgresql://user:password@host:5432/dbname
#
# Multi-tenant isolation (ADR-0038): connect with the DEDICATED non-superuser
# role 'dominus_app', never with the POSTGRES_USER superuser. Superusers bypass
# row-level security even with FORCE ROW LEVEL SECURITY, so connecting as the
# admin would leave tenant isolation to application-level filters alone.
# The role is provisioned by deploy/postgres/init-app-role.sh on first init
# (password: DOMINUS_APP_PASSWORD).
# DATABASE_URL=postgresql://dominus_app:password@localhost:5432/dominus

# SQLite busy timeout in ms (default: 30000 = 30s).
# Increase for bulk pipeline writes concurrent with API reads (ADR-0023).
# DATABASE_BUSY_TIMEOUT=30000

# Port for the API/Express server (default: 3000).
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Pretty-print logs (pino-pretty). Use for local dev; disable in production.
# LOG_PRETTY=true

# --- Provider rate limiting ---
#
# RDAP: token-bucket rate limiter (defaults: 10 tokens / 1000ms window).
# RDAP_RATE_LIMIT_TOKENS=10
# RDAP_RATE_LIMIT_INTERVAL_MS=1000
#
# Distributed per-tenant fair share (Cloud / Redis, ADR-0041): when the Redis
# rate limiter is active (DOMINUS Cloud), each tenant is granted its own
# per-tenant window on top of the shared platform bucket, so one tenant can
# never monopolise the whole budget. PROVIDER_FAIR_SHARE_ENABLED is the
# global kill-switch (default: true). per-tenant tokens <= shared tokens.
# RDAP_RATE_LIMIT_PER_TENANT_TOKENS=3
# RDAP_RATE_LIMIT_PER_TENANT_INTERVAL_MS=1000
# DNS_RATE_LIMIT_PER_TENANT_TOKENS=5
# DNS_RATE_LIMIT_PER_TENANT_INTERVAL_MS=1000
# PROVIDER_FAIR_SHARE_ENABLED=true
#
# WHOIS: token-bucket rate limiter (defaults: 2 tokens / 2000ms window).
# WHOIS servers are generally more restrictive than RDAP.
# WHOIS_RATE_LIMIT_TOKENS=2
# WHOIS_RATE_LIMIT_INTERVAL_MS=2000
# Per-tenant fair share (Cloud only, ADR-0041/ADR-0052): max WHOIS tokens per
# tenant per window, on top of the shared bucket when Redis is the rate
# limiter and PROVIDER_FAIR_SHARE_ENABLED=true. WHOIS is the strictest
# channel: a dedicated 'whois' Redis namespace keeps N replicas at ONE
# registry-facing rate and stops a tenant from starving the others.
# WHOIS_RATE_LIMIT_PER_TENANT_TOKENS=1
# WHOIS_RATE_LIMIT_PER_TENANT_INTERVAL_MS=2000
# Per-TLD overrides (JSON): each entry overrides the global tokens/interval
# for that TLD. Structure: { "<.tld>": { maxTokens?, tokensPerInterval, intervalMs } }.
# When Redis is connected, each override maps to its own 'whois:<tld>' bucket.
# WHOIS_RATE_LIMIT_OVERRIDES={"de":{"tokensPerInterval":1,"intervalMs":20000}}
#
# DNS: bulk concurrency — max domains checked in parallel per batch (default: 200).
# Increase for large pipelines (50k+ candidates); monitor event-loop lag.
# DNS_BULK_CONCURRENCY=200
# DNS: per-domain lookup timeout in ms (default: 1500).
# DNS_LOOKUP_TIMEOUT_MS=5000
# DNS: in-memory cache TTL in seconds (default: 300 = 5 min).
# DNS_CACHE_TTL_SECONDS=300
#
# DNS: parking page detection for registered domains (default: false).
# When enabled, domains whose A records resolve to known parking IP ranges
# (GoDaddy, Sedo, Dan.com, etc.) pass through the DNS prefilter instead of
# being filtered. This allows the pipeline to evaluate aftermarket domains
# that are technically "registered" but available for purchase.
# DNS_PARKING_CHECK_ENABLED=false
#
# DNS: persistent-cache staleness window for Available rows, in hours
# (default: 24). A domain reported Available older than this window is
# re-checked live instead of served from the persistent cache — a false
# positive would otherwise survive for the full DNS_PERSISTENT_CACHE_TTL_HOURS
# (7 days) and produce a wasted buy recommendation. Registered rows are
# served for the full TTL (conservative outcome). Unknown rows keep their
# 15-minute re-check window.
# DNS_PERSISTENT_AVAILABLE_STALE_HOURS=24
#
# DNS: path to JSON file with parking IP ranges (CIDR notation).
# When absent or missing, the bundled reference list ships with the binary
# (GoDaddy, Sedo, Dan.com, …) so DNS_PARKING_CHECK_ENABLED=true works out of
# the box (ADR-0059). An explicit readable file always wins over the bundle.
# Format: [{ "name": "GoDaddy", "cidr": ["208.109.0.0/16", ...] }, ...]
# DNS_PARKING_IPS_PATH=./src/providers/dns/parking-ips.json

# --- Unbound Resolver (ADR-0072/0075: Single Source of Truth) ---
#
# Single properly configured Unbound recursive resolver replaces the
# multi-leg consensus architecture (DoH/DoT/tertiary). When enabled (default),
# ALL DNS queries route through Unbound with full DNSSEC validation, DoT
# upstream, and anycast-free resolution. No commercial signal leaks to
# public resolvers (Cloudflare/Google/Quad9/AdGuard/Mullvad/NextDNS/OpenDNS).
#
# Enable Unbound resolver (default: true). Unbound is the single source of truth.
# DNS_UNBOUND_ENABLED=true
#
# Comma-separated Unbound host(s) for the resolver.
# Examples: '127.0.0.1,::1' (host), 'unbound:5300' (Docker service name),
# '10.0.0.1:5300,[::1]:5300' (explicit ports).
# When DNS_UNBOUND_ENABLED=true, this is REQUIRED.
# DNS_UNBOUND_HOSTS=unbound:5300
#
# Use DNS-over-TLS to Unbound (port 853) instead of plain DNS (port 53).
# When true, queries are encrypted between the application and Unbound.
# Requires Unbound configured with tls-service-key, tls-service-pem, tls-port: 853.
# Default: true for defense-in-depth.
# DNS_UNBOUND_TLS=true
#
# Per-query timeout in milliseconds for Unbound resolution.
# Each individual DNS resolution (A, AAAA, NS, SOA) has this timeout.
# Default: 1500ms (1.5 seconds).
# DNS_UNBOUND_TIMEOUT_MS=1500
#
# DNSSEC validation mode for Available verdicts (default: 'strict').
# - 'strict': Only 'valid' DNSSEC passes (conservative, ADR-0002).
# - 'permissive': 'valid' OR 'insecure' (unsigned zones) pass.
# - 'disabled': DNSSEC not required for Available verdicts.
# Applies to both UnboundResolver and DnsPreFilterStage when DNS_UNBOUND_ENABLED=true.
# When DNS_UNBOUND_ENABLED=false (native fallback), this only affects DnsPreFilterStage.
# DNSSEC_MODE=strict
#
# Strict Unbound mode (default: CONTEXT-AWARE).
# - Cloud mode (DATABASE_URL set OR AUTH_PROVIDER !== 'env'): defaults to TRUE
#   (hardened, mandatory Unbound with DNSSEC validation proof).
# - Community edition (SQLite + AUTH_PROVIDER=env): defaults to FALSE
#   (allows NodeDnsFallback for zero-dependency onboarding).
# Explicit env var ALWAYS wins over detected default.
# ADR-0076: Community edition gets fallback; Cloud edition stays hardened.
# DNS_UNBOUND_STRICT=
#
# Quorum mode for multi-host Unbound deployments (ADR-0078, default: 'majority').
# - 'simple': Uses DNS_UNBOUND_MIN_HEALTHY_HOSTS directly (legacy behavior).
# - 'majority': Requires ceil(configuredHosts / 2) healthy hosts — true quorum.
# - 'all': All configured hosts must be healthy.
# Single-host deployments (community): ceil(1/2)=1 — valid but no redundancy.
# Three-host deployments (production): ceil(3/2)=2 — tolerates 1 failure.
# DNS_UNBOUND_QUORUM_MODE=majority
#
# Enable parking page detection for registered domains via Unbound.
# When true, registered domains whose A records resolve to known parking
# IP ranges pass through with `dnsStatus: 'parked'`, allowing RDAP and
# scoring to evaluate aftermarket availability.
# Default: false (parked domains filtered as Registered).
# DNS_PARKING_CHECK_ENABLED=false

# Provider cache TTL (default: 7 days). Reduces repeated API calls.
# PROVIDER_CACHE_TTL_DAYS=7

# --- DNS Fallback Resolver (ADR-0076: Community Edition Onboarding) ---
#
# When DNS_UNBOUND_STRICT=false (community edition default), a FallbackResolver
# wraps UnboundResolver and delegates non-Available verdicts to a secondary
# provider (Node.js DNS by default) when Unbound is unhealthy or loses DNSSEC
# validation. CRITICAL: The fallback is NEVER used for "Available" verdicts —
# those require DNSSEC validation from Unbound (conservative, ADR-0002).
#
# Enable DNS fallback for graceful degradation (default: true).
# DNS_FALLBACK_ENABLED=true
#
# Fallback DNS provider type (default: 'node-dns').
# - 'node-dns': Node.js native DNS resolver (systemd-resolved, /etc/resolv.conf).
#   The only implemented fallback.
# - 'cloudflare-doh' / 'google-doh': reserved for future DoH redundancy.
#   Selecting either fails closed at startup — set node-dns.
# DNS_FALLBACK_PROVIDER=node-dns
#
# Only use fallback for non-Available verdicts (SAFETY GATE, default: true).
# When true, the fallback provider is ONLY consulted for
# Registered/Unknown/Parked verdicts. If primary is degraded and returns
# Available, we return Unknown instead of delegating to fallback.
# This prevents false-positive Available verdicts from non-DNSSEC-validating resolvers.
# DNS_FALLBACK_ONLY_FOR_NON_AVAILABLE=true

# --- RDAP multi-server failover ---
#
# JSON array of RDAP bootstrap server entries for resilience.
# When set, the IANA bootstrap resolution below is skipped. Each entry is
# either a plain URL string (universal scope — authoritative for all TLDs,
# operator takes responsibility) or an object scoping the server to specific
# TLDs. Scoped servers never report "available" for out-of-scope TLDs — a
# 404 from a server that is not authoritative for the domain's TLD is Unknown.
# Example:
#   RDAP_BOOTSTRAP_URLS=["https://rdap.org/domain/", {"url": "https://rdap.verisign.com/com/domain/", "tlds": ["com", "net"]}]
# RDAP_BOOTSTRAP_URLS=
#
# URL of the IANA RDAP bootstrap registry (RFC 7484). The authoritative RDAP
# server for each TLD is resolved from it (plus the rdap.org routing
# fallback). Empty string disables per-TLD resolution (rdap.org only).
# Default: https://data.iana.org/rdap/dns.json
# RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json

# Maximum keep-alive connections per RDAP origin for the shared undici Agent
# pool (ADR-0049). Lazy-created; idle deployments hold no sockets.
# Default: 32. Range: 1-512.
# RDAP_MAX_CONNECTIONS=32

# Maximum acceptable RDAP response body size in bytes. Larger responses are
# aborted (Content-Length pre-check + streamed read cap) so a hostile or
# misbehaving registry cannot feed the process an unbounded body.
# Default: 1048576 (1 MiB). Range: 1024-10485760 (10 MiB).
# RDAP_MAX_RESPONSE_BYTES=1048576

# RDAP 2-of-2 consensus gate (ADR-0050): every Available verdict from the
# primary failover is independently confirmed by a dedicated second RDAP
# provider. ON by default (ADR-0058): a disagreement or unverifiable
# confirmation fails the verdict closed.
# RDAP_CONSENSUS_ENABLED=true
# Endpoint of the dedicated second RDAP opinion. Default: https://rdap.org/
# The second opinion must come from an origin you explicitly trust as
# independent of the primary bootstrap. The gate skips candidates whose TLD
# the second origin itself is authoritative for (origin-overlap guard,
# ADR-0058): for those TLDs the 2-of-2 would be a rubber stamp. https only.
# RDAP_CONSENSUS_ENDPOINT=https://rdap.org/
# Opt-in WHOIS rescue leg (ADR-0051): when the second RDAP leg cannot answer,
# the verdict is re-checked through WHOIS within the stage's bounded budget.
# WHOIS "available" confirms, WHOIS "registered" vetoes, WHOIS timeout stays
# unverifiable. Never consulted on a definitive second-leg Registered. OFF by
# default: the fail-closed 2-of-2 rule remains the default posture.
# RDAP_CONSENSUS_RESCUE_WHOIS_ENABLED=false
# Fraction of consensus-confirmed Available domains that may be unverifiable
# before the run is flagged degraded. Default: 0.5. Range: 0.01-1.
# RDAP_CONSENSUS_DEGRADED_RATIO=0.5
# Minimum consensus-confirmed domains before degradation is considered.
# RDAP_CONSENSUS_DEGRADED_MIN=10
# Dedicated rate budget for the second RDAP consensus leg (own Redis
# namespace) so a heavy primary run cannot starve the gate. Default: 5/s.
# RDAP_CONSENSUS_RATE_LIMIT_TOKENS=5
# RDAP_CONSENSUS_RATE_LIMIT_INTERVAL_MS=1000
# RDAP_CONSENSUS_RATE_LIMIT_PER_TENANT_TOKENS=2
# RDAP_CONSENSUS_RATE_LIMIT_PER_TENANT_INTERVAL_MS=1000
# Concurrency ceiling for the RDAP consensus verification phase.
# RDAP_CONSENSUS_BULK_CONCURRENCY=10
# Timeout for a single RDAP consensus query on the second leg (ms).
# RDAP_CONSENSUS_TIMEOUT_MS=10000

# Fail-open behavior for RDAP consensus probe (ADR-0077, default: CONTEXT-AWARE).
# When true, a failed probe at startup logs a warning but does NOT exit the process.
# The 2-of-2 consensus gate is disabled for this run, and a warning metric is emitted.
# When false, a failed probe causes the application to fail startup.
# Default: context-aware — true in cloud mode (DATABASE_URL or AUTH_PROVIDER !== 'env'),
# false in community edition. The 2-of-2 consensus gate is a safety-critical
# guarantee (ADR-0050); silent degradation to single-leg RDAP defeats its purpose.
# Cloud mode defaults to fail-open for operational resilience against rdap.org outages.
# RDAP_CONSENSUS_PROBE_FAIL_OPEN=

# Number of retry attempts for the RDAP consensus startup probe (default: 3).
# RDAP_CONSENSUS_PROBE_RETRY=3
# Base backoff in milliseconds for RDAP consensus probe retries (default: 5000).
# RDAP_CONSENSUS_PROBE_BACKOFF_MS=5000

# IANA RDAP bootstrap resilience (ADR-0058): exponential backoff between
# consecutive refresh failures, capped at the max below. The bootstrap keeps
# serving the last-known-good server map during a backoff window.
# Default: base 5 minutes, max 24 hours.
# RDAP_BOOTSTRAP_RETRY_BASE_MS=300000
# RDAP_BOOTSTRAP_RETRY_MAX_MS=86400000

# Optional: path to Google Keyword Planner JSON export.
# Format: [{ "term": "cloud", "monthlySearchVolume": 12000, "cpc": 4.5, "competition": 0.7 }, …]
# When absent, all keyword lookups return zero volume (intrinsic signal only).
# KEYWORD_DATA_PATH=./examples/keywords-sample.json

# Keyword provider implementation (default: google-suggest).
# Options:
#   - google-suggest : Zero-cost provider using Google Suggest public API.
#                      Estimates search volume and CPC from autocomplete
#                      suggestion count. No API key required. Recommended
#                      for the community edition.
#   - manual         : Reads keyword data from KEYWORD_DATA_PATH JSON file.
#                      Useful for providing your own search volume data.
#   - google-ads     : Google Ads Keyword Planner (requires paid API access).
# KEYWORD_PROVIDER=google-suggest

# Google Ads Keyword Planner API credentials (required when KEYWORD_PROVIDER=google-ads).
# Register at: https://console.cloud.google.com/apis/credentials (OAuth2 client)
# Developer token: https://developers.google.com/google-ads/api/docs/first-call/dev-token
# Free tier: 10,000 queries/day per developer token.
# GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=your-client-secret
# GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
# GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
# GOOGLE_ADS_CUSTOMER_ID=1234567890

# Optional: path to NameBio comparable sales CSV export.
# Columns: domain,price,date,venue  (header row required)
# When absent, no comparable sales are used in scoring.
# COMPS_DATA_PATH=./examples/comps-sample.csv

# Comparable-sales provider implementation (default: manual).
# Options: manual, namebio
# COMPS_PROVIDER=manual

# API key for the NameBio API (namebio.com/api).
# Register at namebio.com/api to get a free API key.
# When absent, the NameBio provider gracefully returns zero results.
# NAMEBIO_API_KEY=your-namebio-api-key

# --- Authentication (DOMINUS Cloud) ---
#
# Auth provider: 'env' (community edition, API_KEYS env var) or 'auth0' (Cloud, JWT).
# Default: 'env'.
# AUTH_PROVIDER=env
#
# Auth0 configuration (required when AUTH_PROVIDER=auth0).
# Register at: https://auth0.com/signup
# AUTH0_DOMAIN=dominus.eu.auth0.com
# AUTH0_AUDIENCE=https://api.dominus.app
# Optional: custom JWKS URI (defaults to https://{AUTH0_DOMAIN}/.well-known/jwks.json).
# AUTH0_JWKS_URI=https://dominus.eu.auth0.com/.well-known/jwks.json
#
# Interactive SSO login (OIDC Authorization Code + PKCE, ADR-0062).
# The /api/v1/auth/oidc endpoints are mounted ONLY when all three are set
# (fail-closed: bearer-token validation keeps working without them).
# Create a "Regular Web Application" in Auth0 and add the callback URL
# below to its Allowed Callback URLs.
# AUTH0_CLIENT_ID=your-auth0-application-client-id
# AUTH0_CLIENT_SECRET=your-auth0-application-client-secret
# AUTH0_CALLBACK_URL=https://dominus.app/api/v1/auth/oidc/callback
# Session cookie lifetime in hours (default: 8).
# AUTH0_SESSION_TTL_HOURS=8
# WARNING: rotating AUTH0_CLIENT_SECRET signs every SSO session out
# (sessions are HMAC-signed with a key derived from it).

# --- Trademark providers ---

# USPTO public search URL (no API key required; default is the official endpoint).
# USPTO_SEARCH_URL=https://tmsearch.uspto.gov/search/search-information

# EUIPO Trademark Search 1.1.0 (RSQL-based, OAuth2 client_credentials).
# Register at: https://euipo.europa.eu/ohimportal/en/open-data
# The same client_id is sent as `X-IBM-Client-Id` on every search request.
# When absent, EUIPO is skipped and the gate degrades gracefully to USPTO-only.
# EUIPO_CLIENT_ID=your-client-id
# EUIPO_CLIENT_SECRET=your-client-secret
# EUIPO_AUTH_URL=https://euipo.europa.eu/oauth2/token
# EUIPO_API_URL=https://api.euipo.europa.eu/trademark-search/trademarks

# Number of days a cached trademark result stays valid (default: 7).
# TM_CACHE_TTL_DAYS=7

# --- WHOIS port-43 provider ---
#
# Maximum milliseconds to wait for a WHOIS server response.
# Increase (e.g. 20000) for slow ccTLD servers; decrease (e.g. 5000) to fail fast.
# WHOIS_LOOKUP_TIMEOUT=10000

# Maximum milliseconds a single WHOIS cross-validation may take before the
# stage treats RDAP as authoritative and skips the WHOIS result (default: 1000).
# WHOIS is an optional enrichment: a slow disagreement must never block a run
# (ADR-0035). See RDAP_WHOIS_BUDGET_MS below for the stage-level cap.
# WHOIS_LOOKUP_TIMEOUT is per-query; RDAP_WHOIS_BUDGET_MS is per-domain budget.


# --- Budget / Safety ---
#
# Absolute cap on 'suggested_buy_max' in EUR (default: 0 = uncapped).
# expectedValue is anchored to the market signal's median comparable sale
# when market data exists (ADR-0055); a fixed ceiling would flatten every
# above-cap domain to the same recommendation. Set a positive value to
# enforce a hard per-deal budget regardless of evidence.
# BUY_MAX_ABSOLUTE_CAP=0

# Number of years held in suggested_buy_max calculation (default: 3).
# Longer horizon = lower buy max due to cumulative renewal costs.
# SCORING_HOLDING_YEARS=3

# Fraction of confidence range influenced by intrinsic quality (default: 0.12).
# See ADR-0020 for the full formula.
# SCORING_INTRINSIC_QUALITY_INFLUENCE=0.12

# Path to a JSON file with manual weight overrides.
# Overrides both DEFAULT_WEIGHTS and auto-tuned weights.
# Format: { "intrinsic": 0.3, "commercial": 0.35, "market": 0.25, "expiry": 0.1 }
# SCORING_WEIGHTS_OVERRIDE=./data/weights-override.json

# --- Scoring signal calibration ---
#
# These parameters control the internal behaviour of each scoring signal.
# Defaults reflect the original conservative tuning; fork freely.
#
# SCORING_IDEAL_LENGTH=7            # Ideal SLD length (intrinsic signal)
# SCORING_MAX_LENGTH=20             # Max SLD length before score = 0
# SCORING_MAX_VOLUME=1000000        # Max monthly search volume ceiling
# SCORING_MAX_CPC=50                # Max CPC ceiling
# SCORING_FLOOR_VALUE=500           # Floor market value in EUR
# SCORING_HIGH_VALUE=10000          # High market value in EUR
# SCORING_MAX_AGE_YEARS=20          # Max domain age for expiry signal
# SCORING_MAX_BACKLINKS=1000        # Max backlinks for expiry signal
# SCORING_MAX_WAYBACK=500           # Max Wayback snapshots for expiry signal
# SCORING_BUY_MAX_RATIO=0.5         # suggestedBuyMax = expectedValue × this
# SCORING_LIST_PRICE_MULTIPLIER=2.5 # suggestedListPrice = expectedValue × this
# SCORING_BASE_MARKET_VALUE=500     # Base EUR value for expected value calc
# SCORING_CONFIDENCE_BASE=0.2       # Starting confidence with 1 signal
# SCORING_CONFIDENCE_CAP=0.8        # Absolute confidence cap

# --- TLD bonus overrides ---
#
# Path to a JSON file mapping TLDs to multiplier bonuses.
# Merged with defaults (.com=1.0, .io=0.85, .ai=0.9, .co=0.75, .net=0.65, .org=0.55).
# Unknown TLDs fall back to 0.3.
# Format: { ".com": 1.0, ".xyz": 0.4 }
# TLD_BONUSES_PATH=./data/tld-bonuses.json

# --- Candidate generation ---
#
# Default TLD appended to bare keywords (default: .com).
# DEFAULT_KEYWORD_TLD=.com

# --- Trademark matching calibration ---
#
# TRADEMARK_MIN_TOKEN_LENGTH_FUZZY=4       # Min token length for Levenshtein matching
# TRADEMARK_MIN_MARK_TOKEN_LENGTH_SUBSTRING=3  # Min mark token length for substring
# TRADEMARK_MAX_LEVENSHTEIN=1              # Max edit distance for fuzzy matching
# TRADEMARK_PROVIDER_TIMEOUT_MS=15000      # Per-provider gate deadline (ms, min 1000); a fired deadline counts as provider failure
# Anonymous trademark budget isolation (ADR-0056). When enabled, the public
# (anonymous) valuation namespace draws trademark-gate capacity from its own
# dedicated budget instead of the shared USPTO/EUIPO buckets, so a public
# traffic spike can never starve pipeline runs of trademark capacity.
# Fail-open: a valuation that cannot obtain a slot within
# ANON_TRADEMARK_ACQUIRE_TIMEOUT_MS returns an 'unverified' verdict (buy
# signal stripped, ADR-0006) without touching the provider. Disabled by
# default — the community edition behaves as before.
# ANON_TRADEMARK_BUDGET_ENABLED=false
# ANON_TRADEMARK_RATE_LIMIT_TOKENS=2        # Max anonymous trademark checks per interval (burst)
# ANON_TRADEMARK_RATE_LIMIT_INTERVAL_MS=1000  # Budget refill interval
# ANON_TRADEMARK_ACQUIRE_TIMEOUT_MS=1000    # Max wait for a budget slot before failing open (min 100, max 15000)

# --- Pipeline & Batch Config ---
#
# Per-pipeline-stage timeout in ms (default: 3600000 = 1 hour).
# PIPELINE_TIMEOUT_MS=3600000
# Persist per-stage checkpoint data to the DB so interrupted runs resume from
# the last completed stage (pipeline_checkpoints table). Disable to avoid the
# extra write volume. (default: true)
# PIPELINE_CHECKPOINTS_ENABLED=true
# Candidate-scaled per-stage execution budget (ADR-0037). A stage gets
# baseMs + perCandidateMs * candidates, capped at capMs, with graceMs of extra
# time to harvest partial results before the stage is aborted. When a stage is
# aborted the run finishes marked `degraded` with degradedReasons (CLI exits
# non-zero) instead of failing silently with an empty result.
# STAGE_TIMEOUT_BASE_MS=30000
# STAGE_TIMEOUT_PER_CANDIDATE_MS=200
# STAGE_TIMEOUT_CAP_MS=3600000
# STAGE_TIMEOUT_GRACE_MS=5000
# Budget (ms) allowed per domain for the optional WHOIS cross-validation
# during RDAP confirmation (default: 1000, min 50, max 5000). If WHOIS does
# not answer in time, RDAP stays authoritative (ADR-0035).
# RDAP_WHOIS_BUDGET_MS=1000
# RDAP: persistent-cache staleness window for Available rows, in hours
# (default: 24). A domain reported Available older than this window is
# re-checked live instead of served from the provider cache — a false
# positive would otherwise survive for the full PROVIDER_CACHE_TTL_DAYS
# (7 days) and produce a wasted buy recommendation. Registered rows are
# served for the full TTL (conservative outcome). Mirrors
# DNS_PERSISTENT_AVAILABLE_STALE_HOURS.
# RDAP_PERSISTENT_AVAILABLE_STALE_HOURS=24
# Concurrency limits for batch operations (defaults: 5).
# RDAP_BATCH_CONCURRENCY=5
# TRADEMARK_BATCH_CONCURRENCY=5
# SCORING_BATCH_CONCURRENCY=5
# RESCORE_BATCH_CONCURRENCY=5

# --- API Server ---
#
# Network interface to bind the Express server to (default: 127.0.0.1).
# HOST=127.0.0.1
# Request timeout in ms (default: 30000).
# REQUEST_TIMEOUT_MS=30000
# CORS origin (default: http://localhost:5173 for Vite dev).
# CORS_ORIGIN=http://localhost:5173
# Rate limit window in ms (default: 900000 = 15 min).
# RATE_LIMIT_WINDOW_MS=900000
# Max requests per window (default: 100).
# RATE_LIMIT_MAX=100
# Number of reverse proxy hops to trust (default: 0 = direct deployment).
# When this server is reachable by clients directly (no proxy in front),
# keep 0 — trusting X-Forwarded-For without a proxy lets clients spoof
# their IP and empty every per-IP rate limit. Set 1 behind nginx-ingress,
# Cloudflare, Traefik, etc.
# TRUST_PROXY_DEPTH=1
#
# Public (anonymous /public) per-IP rate limits. Tune upward only for
# large self-hosted installs; see ADR-0043.
# PUBLIC_RATE_LIMIT_WINDOW_MS=60000
# PUBLIC_RATE_LIMIT_MAX=30
# PER_DOMAIN_RATE_LIMIT_WINDOW_MS=60000
# PER_DOMAIN_RATE_LIMIT_MAX=5
# POST_RATE_LIMIT_WINDOW_MS=60000
# POST_RATE_LIMIT_MAX=10
# POST_BODY_MAX_BYTES=1000
# Canonical URL for the public SEO pages (score pages, sitemap.xml, robots.txt).
# Used for canonical/og:url/og:image links and as the Organization URL in
# JSON-LD. When unset, each request falls back to its own Host header —
# correct for self-hosted deployments behind a reverse proxy (verify
# HOST/TRUST_PROXY_DEPTH so the scheme is right).
# PUBLIC_APP_URL=https://scores.dominus.app
#
# Internet-exposed deployments MUST set PUBLIC_APP_URL or this allowlist:
# without either, public canonical/OG/sitemap URLs mirror the Host header and
# can be poisoned by crafted requests through cacheable responses. When
# PUBLIC_APP_URL is unset, Hosts NOT in this comma-separated list are pinned
# back to the first allowed hostname.
# PUBLIC_ALLOWED_HOSTS=dominus.app,www.dominus.app

# --- Frontend SPA ---
#
# Path to the built frontend dist directory (default: ./frontend/dist).
# FRONTEND_DIST_PATH=./frontend/dist
# Base path for frontend API proxy (default: /api).
# FRONTEND_BASE_PATH=/api

# --- Drop Verdict Engine ---
#
# Score threshold for "threshold" drop method (0-100 scale, default: 25).
# Domains below this score + renewal imminent = Drop recommendation.
# DROP_SCORE_THRESHOLD=25
# Renewal horizon days for drop verdict (default: 60).
# If renewal is within this window and score is low, recommend drop.
# DROP_RENEWAL_HORIZON_DAYS=60
# Drop method: threshold | npv (default: threshold).
# DROP_METHOD=threshold
# NPV discount rate (decimal, default: 0.05 = 5%).
# DROP_NPV_DISCOUNT_RATE=0.05
# NPV horizon in years (default: 5).
# DROP_NPV_HORIZON_YEARS=5

# --- Renewal Monitoring & Notifications ---
#
# Thresholds for renewal alert generation (defaults: 30 warning, 7 critical).
# RENEWAL_WARNING_DAYS=30
# RENEWAL_CRITICAL_DAYS=7

# Enable desktop notifications via notify-send (Linux/BSD only).
# NOTIFIER_DESKTOP_ENABLED=false

# Generic webhook URL for alert forwarding (Slack, Discord, etc.).
# NOTIFIER_WEBHOOK_URL=https://hooks.example.com/alert

# Telegram bot integration. Create a bot via @BotFather to get a token.
# NOTIFIER_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# NOTIFIER_TELEGRAM_CHAT_ID=-1001234567890

# --- Watchlist Polling ---
#
# Interval between watchlist polls in hours (default: 6).
# WATCHLIST_POLL_INTERVAL_HOURS=6
# Delay between RDAP requests per domain in ms (default: 1000).
# WATCHLIST_RDAP_DELAY_MS=1000

# --- Scheduler (in-process cron) ---
#
# Enable when the API server runs as a long-lived process.
# For one-shot execution (crontab compatible), use:
#   dominus scheduler run <job>
# SCHEDULER_ENABLED=false
# SCHEDULER_RENEWAL_CHECK_CRON=0 8 * * *
# SCHEDULER_RESCORE_CRON=0 9 * * 1
# SCHEDULER_PRUNE_CRON=0 10 1 * *
# SCHEDULER_WATCHLIST_CRON=0 */6 * * *
# Scheduler warmup delay in ms (default: 5000).
# SCHEDULER_WARMUP_MS=5000

# --- Backup ---
#
# Directory for VACUUM INTO backups (default: ./data/backup).
# In the base and production compose profiles the scheduler/worker mount a
# dedicated `backups` volume at /backups and this is set to /backups — keep
# the backups off the disk that holds dominus.db. For true off-disk
# durability mount an external drive (e.g. Hetzner Volume) at /backups
# instead.
# BACKUP_DIR=./data/backup
# Retention in days (default: 30).
# BACKUP_RETENTION_DAYS=30
# Backup cron expression (default: 0 4 * * * = daily at 04:00).
# SCHEDULER_BACKUP_CRON=0 4 * * *

# --- Point-in-time recovery (PostgreSQL / DOMINUS Cloud only, ADR-0054) ---
#
# The pitr-health job verifies WAL archiving lag and base-backup freshness
# and feeds the dominus_pitr_* Prometheus gauges (Pitr* alert rules).
# Only registered when DATABASE_URL points at PostgreSQL; no-op on SQLite.
# Pitr-health cron expression (default: every 15 minutes).
# SCHEDULER_PITR_HEALTH_CRON=*/15 * * * *
# Max acceptable WAL archiving lag in bytes (default: 64MB = ~4 segments).
# PITR_WAL_LAG_MAX_BYTES=67108864
# Max age in hours of the newest base backup (default: 26h for a daily base).
# PITR_BASE_BACKUP_MAX_AGE_HOURS=26

# --- Production image pinning (docker compose -f docker-compose.prod.yml) ---
#
# Tag of the ghcr.io image to deploy. The Deploy workflow publishes
# `master`, `sha-<commit>` and `vX.Y.Z` tags. Defaults to `master`.
# Pin DOMINUS_IMAGE_TAG to the exact sha tag of the commit you verified to
# get immutable, introspectable rollouts (the compose file references the
# whole image by tag, never by digest, so a pinned tag is your audit trail).
# DOMINUS_IMAGE_TAG=sha-6f4b3c2a1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a

# --- Auto Weight Tuning ---
#
# When enabled, the system periodically runs backtest → suggest → validate
# → apply cycle on scoring weights. Safety guardrails prevent runaway drift.
# Start with AUTO_TUNE_DRY_RUN=true to preview changes before live tuning.
# AUTO_TUNE_ENABLED=false
# AUTO_TUNE_WEIGHTS_PATH=./data/weights-override.json
# AUTO_TUNE_MIN_SAMPLE=20
# AUTO_TUNE_MAX_DELTA=0.05
# AUTO_TUNE_MAX_DRIFT=0.20
# AUTO_TUNE_DRY_RUN=true
# AUTO_TUNE_CRON=0 6 1 * *

# --- API Authentication ---
#
# Comma-separated API keys for REST API authentication.
# When empty or unset, authentication is disabled (not recommended for
# production deployments). Supports named keys with name=key format:
#   API_KEYS=sk-my-secret
#   API_KEYS=admin=sk-admin-key,readonly=sk-readonly-key
#
# For production, prefer FILE_API_KEYS to avoid exposing keys in process
# listings (/proc/self/environ). FILE_API_KEYS takes precedence.
# File format: one key per line, supports # comments and name=key format.
# File should have permissions 0600.
#   FILE_API_KEYS=/etc/dominus/api-keys.conf
#
# Clients authenticate via Authorization: Bearer <key> header.
# The /api/health endpoint is always accessible without auth.
# API_KEYS=

# Optional bearer token protecting the /api/v1/metrics/* router (Prometheus
# scrape + run-history endpoints). When set, every metrics request must carry
# Authorization: Bearer <METRICS_TOKEN>; requests without it get 401.
# When empty, metrics stay public (legacy behaviour) — rely on the reverse
# proxy / nginx block to restrict access. Internet-exposed deployments
# MUST either set this token or block /api/v1/metrics* at the proxy: the
# router is mounted before the global rate limiter and discloses queue
# stats, dead-letter counts and run history. When you enable it, configure
# the Prometheus scrape to send the same token (authorization block in
# deploy/prometheus/prometheus.yml) or scraping will fail with 401.
# METRICS_TOKEN=

# --- Registrar Providers ---
#
# Default registrar provider for purchases (default: manual).
# Options: manual, cloudflare (the only implemented registrar).
# When set to manual, all purchase operations return failure (safe default).
# REGISTRAR_PROVIDER=manual
#
# Purchase auto-approval mode: never | under-buy-max | always (default: never).
# Recommended: start with 'never', switch to 'under-buy-max' after testing.
# PURCHASE_AUTO_APPROVAL=never
#
# File-based registrar config (secure alternative to env vars).
# Format: one provider per section with [provider_name] header.
# Takes precedence over individual env vars for security.
# FILE_REGISTRAR_CONFIG=/etc/dominus/registrar.conf
#
# --- Cloudflare Registrar ---
# API token with Zone:Read, Registrar:Read, and Registrar:Write permissions.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# REGISTRAR_CLOUDFLARE_API_TOKEN=
# Cloudflare Account ID (found in the dashboard overview page).
# REGISTRAR_CLOUDFLARE_ACCOUNT_ID=
#

# --- Listing provider ---
#
# Only `manual` (local-only tracking) is implemented; marketplace adapters
# (Dan, Afternic, Sedo) were removed until verified API access exists.
# LISTING_PROVIDER=manual

# --- Redis (distributed coordination) ---
#
# Redis connection URL (optional). When set, enables distributed rate
# limiting, pipeline locking, and caching across all processes (API,
# worker, scheduler). Redis is recommended for multi-instance deployments
# (DOMINUS Cloud) but optional for the community edition.
#
# Without Redis, all services fall back to in-memory rate limiters and
# database-based locking. Functionality remains identical; only inter-
# process coordination is lost.
#
# Format: redis[s]://[[username][:password]@]host[:port][/db-number]
# REDIS_URL=redis://localhost:6379
#
# Enable TLS for Redis connection (default: false).
# Set to true when using Redis over TLS (e.g. Upstash, Redis Cloud).
# REDIS_TLS_ENABLED=false
#
# Key prefix for all Redis keys (default: "dominus:").
# Use different prefixes per environment (dev/staging/prod) when sharing
# a single Redis instance.
# REDIS_KEY_PREFIX=dominus:
#
# Maximum reconnection retries (default: 10).
# REDIS_MAX_RETRIES=10
#
# Base retry delay in ms (default: 200). Backoff is exponential.
# REDIS_RETRY_BASE_MS=200

# --- Billing (Stripe, DOMINUS Cloud) ---
#
# Stripe secret key (sk_test_... / sk_live_...). When set, billing features
# (checkout, portal, webhooks) are enabled. The webhook endpoint is
# POST /api/v1/billing/webhook.
# STRIPE_SECRET_KEY=sk_test_xxx
#
# Stripe publishable key (pk_test_... / pk_live_...), exposed to the
# frontend for the billing UI.
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
#
# Stripe webhook signing secret (whsec_...). Required to verify webhook
# signatures. Create a webhook in the Stripe Dashboard pointing to
# https://<your-host>/api/v1/billing/webhook with events:
#   checkout.session.completed
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted
# STRIPE_WEBHOOK_SECRET=whsec_xxx
#
# Stripe Price IDs for the Pro plan (legacy aliases, still supported):
# STRIPE_PRICE_ID_MONTHLY=price_xxx
# STRIPE_PRICE_ID_YEARLY=price_xxx
#
# Explicit per-interval Price IDs for the Pro plan. When set, these take
# precedence over the legacy aliases above.
# STRIPE_PRICE_ID_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_ID_PRO_YEARLY=price_xxx
#
# Stripe Price IDs for the Team plan (€79/mo, 10 seats, 2,500 candidates
# scored/month — metered per calendar month, not per day).
# STRIPE_PRICE_ID_TEAM_MONTHLY=price_xxx
# STRIPE_PRICE_ID_TEAM_YEARLY=price_xxx
#
# Stripe Price IDs for the Enterprise plan (custom pricing). When unset,
# Enterprise is not offered via self-service checkout.
# STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=price_xxx
# STRIPE_PRICE_ID_ENTERPRISE_YEARLY=price_xxx
#
# Default subscription plan for new tenants (free | pro | team | enterprise).
# SUBSCRIPTION_DEFAULT_PLAN=free

# --- Usage metering / enforcement ---
#
# Enforce plan usage limits on API requests: every protected request records
# one `api_calls` unit against the tenant's monthly limit and is rejected
# with HTTP 429 once the limit is exhausted. Default: false (opt-in) for
# the community edition; managed identity (AUTH_PROVIDER=db/auth0) forces
# enforcement ON regardless — a Cloud deploy must never charge for plans
# while metering nothing.
# USAGE_ENFORCEMENT_ENABLED=false
#
# Automatically create a free-plan subscription row for a tenant on its first
# authenticated API request. Required for USAGE_ENFORCEMENT_ENABLED on the
# managed Cloud (enabled automatically there); self-hosted defaults to false
# so request paths never write the DB unexpectedly.
# AUTO_PROVISION_TENANTS=false

# --- Additional settings (defaults shown; every key below is read by src/config.ts) ---
# Uncomment to override. Kept in sync with the config schema by
# src/__tests__/env-example.test.ts.
#
# [ACQUISITION]
# Monthly budget cap for domain acquisition (EUR).
# ACQUISITION_BUDGET_EUR=500
# Maximum number of entries in the acquisition funnel buy-list.
# ACQUISITION_FUNNEL_MAX_ENTRIES=0
# Minimum suggestedBuyMax (EUR) for a candidate to be included in the acquisition funnel.
# ACQUISITION_MIN_BUY_MAX=20
# Minimum confidence score (0-1) for a candidate to be included in the acquisition funnel.
# ACQUISITION_MIN_CONFIDENCE=0.3
#
# [COMMERCIAL]
# Emit a run degradation when commercial signal has no data for a significant portion of candidates (default: true).
# COMMERCIAL_SIGNAL_DEGRADATION_ENABLED=true
#
# [DEFAULT]
# DEFAULT_RENEWAL_COST_EUR=10
#
# [DNS]
# Comma-separated list of positive control domains for DNSSEC validation health checks.
# DNSSEC_POSITIVE_CONTROLS=sigok.verteiltesysteme.net,dnssec.works,test.dnssec-tools.org
# Maximum number of entries in the in-memory DNS result cache.
# DNS_CACHE_MAX_SIZE=10000
# Enable persistent DNS cache via the provider_cache database table.
# DNS_PERSISTENT_CACHE_ENABLED=true
# TTL for persistent DNS cache entries in hours.
# DNS_PERSISTENT_CACHE_TTL_HOURS=168
# Rate limiting: refill interval in ms for DNS resolution requests (default: 1000).
# DNS_RATE_LIMIT_INTERVAL_MS=1000
# Rate limiting: max tokens (burst capacity) for DNS resolution requests.
# DNS_RATE_LIMIT_TOKENS=20
# Per-stage SQLite busy timeout override for DNS prefilter stage bulk writes.
# DNS_STAGE_BUSY_TIMEOUT_MS=
# Maximum age in milliseconds of persisted DNSSEC validation state before it is considered stale and requires revalidation (ADR-0078).
# DNS_UNBOUND_DNSSEC_STATE_MAX_AGE_MS=3600000
# Enable health check for Unbound resolver at startup.
# DNS_UNBOUND_HEALTH_CHECK_ENABLED=true
# Maximum number of unhealthy hosts before considering the resolver degraded.
# DNS_UNBOUND_MAX_UNHEALTHY_BEFORE_DEGRADED=1
# Minimum number of healthy Unbound hosts required for the resolver to be considered operational (quorum).
# DNS_UNBOUND_MIN_HEALTHY_HOSTS=1
# Enable automatic DNSSEC validation state persistence to database (ADR-0078).
# DNS_UNBOUND_PERSIST_DNSSEC_STATE=true
# Enable persistent cache purge on DNSSEC validation loss (ADR-0078).
# DNS_UNBOUND_PURGE_CACHE_ON_DNSSEC_LOSS=true
# Maximum time in milliseconds to wait for Unbound resolver readiness at startup.
# DNS_UNBOUND_READINESS_TIMEOUT_MS=30000
# Interval in milliseconds for periodic DNSSEC revalidation (default: 600000 = 10 min).
# DNS_UNBOUND_REVALIDATION_INTERVAL_MS=600000
# Skip the Unbound resolver readiness wait at startup (test-only).
# DNS_UNBOUND_SKIP_READINESS=false
# Cooldown in ms before retrying an unhealthy host (default: 30000 = 30s).
# DNS_UNBOUND_UNHEALTHY_COOLDOWN_MS=30000
# Enable DNS-over-TLS between Unbound and its upstream recursive resolvers.
# DNS_UNBOUND_UPSTREAM_TLS=true
#
# [EUIPO]
# Rate limiting: refill interval in ms for EUIPO requests (default: 1000).
# EUIPO_RATE_LIMIT_INTERVAL_MS=1000
# Rate limiting: max tokens (burst capacity) for EUIPO trademark requests.
# EUIPO_RATE_LIMIT_TOKENS=5
#
# [EVENTS]
# EVENTS_RETENTION_DAYS=180
#
# [IS]
# IS_CLOUD_MODE=false
#
# [JOB]
# How often the worker refreshes heartbeat_at for its currently running jobs.
# JOB_HEARTBEAT_INTERVAL_MS=15000
# Maximum time a job can stay in 'running' status before being auto-requeued by the worker (stuck-job recovery).
# JOB_MAX_RUNNING_AGE_MS=3600000
# Maximum depth (queued jobs) allowed in the job queue before new enqueue attempts are rejected.
# JOB_QUEUE_MAX_DEPTH=1000
# Poll interval in milliseconds for the job queue worker.
# JOB_QUEUE_POLL_INTERVAL_MS=1000
#
# [LISTING]
# Default marketplace for listings when none is specified.
# LISTING_DEFAULT_MARKETPLACE=manual
# Default multiplier applied to the scoring engine's suggestedListPrice when creating a listing without an explicit price.
# LISTING_DEFAULT_PRICE_MULTIPLIER=1
#
# [OPERATOR]
# Platform operators (cross-tenant /api/v1/admin): comma-separated OIDC subjects and/or `key:<id>`
# DB API key ids. Unset = nobody can reach the operator panel (fail closed).
# OPERATOR_SUBJECTS=auth0|abc123,key:1
#
# [PIPELINE]
# Optional intra-stage checkpoint batch size.
# PIPELINE_CHECKPOINT_BATCH_SIZE=500
# Heartbeat interval for pipeline lock renewal in milliseconds.
# PIPELINE_LOCK_HEARTBEAT_MS=30000
# TTL for the pipeline advisory lock in milliseconds.
# PIPELINE_LOCK_TTL_MS=120000
#
# [PROVIDER]
# Maximum number of entries in the in-memory provider cache (LRU).
# PROVIDER_MEMORY_CACHE_SIZE=1000
# TTL in seconds for in-memory provider cache entries.
# PROVIDER_MEMORY_CACHE_TTL_SECONDS=300
#
# [PUBLIC]
# TTL in milliseconds for the public (anonymous) scoring cache.
# PUBLIC_CACHE_TTL_MS=300000
# PUBLIC_SCORES_RETENTION_DAYS=90
#
# [RDAP]
# Optional per-TLD override for RDAP consensus secondary endpoint (ADR-0077).
# RDAP_CONSENSUS_ENDPOINT_OVERRIDES=
# Timeout for the startup probe of the RDAP consensus second provider (ms).
# RDAP_CONSENSUS_PROBE_TIMEOUT_MS=15000
# Per-TLD override for WHOIS rescue leg (ADR-0051 extension).
# RDAP_CONSENSUS_RESCUE_WHOIS_TLDS=[".it",".de",".jp",".br",".cn",".ru",".fr",".uk"]
# Enable an optional THIRD RDAP consensus opinion (tertiary leg).
# RDAP_CONSENSUS_TERTIARY_ENABLED=false
# Rate limiting: refill interval in ms for the RDAP consensus WHOIS rescue budget (default: 2000).
# RDAP_CONSENSUS_WHOIS_RESCUE_INTERVAL_MS=2000
# Dedicated WHOIS rate budget for RDAP consensus rescue leg (ADR-0051/ADR-0058).
# RDAP_CONSENSUS_WHOIS_RESCUE_TOKENS=2
# Per-stage SQLite busy timeout override for RDAP confirmation stage bulk writes.
# RDAP_STAGE_BUSY_TIMEOUT_MS=
# Concurrency ceiling for the RDAP tertiary verification phase.
# RDAP_TERTIARY_BULK_CONCURRENCY=5
# Endpoint of the dedicated third RDAP opinion (tertiary leg).
# RDAP_TERTIARY_ENDPOINT=
# Rate limiting: refill interval in ms for RDAP tertiary requests (default: 1000).
# RDAP_TERTIARY_RATE_LIMIT_INTERVAL_MS=1000
# Per-tenant fair share: refill interval in ms for the RDAP tertiary tenant window (default: 1000).
# RDAP_TERTIARY_RATE_LIMIT_PER_TENANT_INTERVAL_MS=1000
# Per-tenant fair share (Cloud only, ADR-0041): max RDAP tertiary tokens per tenant per interval, on top of the shared rdap-consensus-tertiary bucket.
# RDAP_TERTIARY_RATE_LIMIT_PER_TENANT_TOKENS=1
# Rate limiting: token bucket for the third RDAP consensus leg.
# RDAP_TERTIARY_RATE_LIMIT_TOKENS=3
# Timeout for a single RDAP tertiary query (ms).
# RDAP_TERTIARY_TIMEOUT_MS=10000
#
# [REDIS]
# When true, REDIS_URL is required at startup and the application refuses to start without it.
# REDIS_REQUIRED=
#
# [SCHEDULER]
# Cron expression for portfolio RDAP/WHOIS healthcheck.
# SCHEDULER_PORTFOLIO_HEALTHCHECK_CRON=0 2 * * 0
#
# [USPTO]
# Rate limiting: refill interval in ms for USPTO requests (default: 1000).
# USPTO_RATE_LIMIT_INTERVAL_MS=1000
# Rate limiting: max tokens (burst capacity) for USPTO trademark requests.
# USPTO_RATE_LIMIT_TOKENS=5
# TSDR (Trademark Status & Document Retrieval) fallback URL for the USPTO trademark search.
# USPTO_TSDR_SEARCH_URL=https://tsdr.uspto.gov/tsdr/tmsearch/data
#
# [WAYBACK]
# Maximum number of concurrent Wayback enrichment lookups during a pipeline stage run.
# WAYBACK_BATCH_CONCURRENCY=3
# CDX API result limit per page.
# WAYBACK_CDX_PAGE_SIZE=5000
# Enable Wayback Machine CDX API for automatic expiry data enrichment.
# WAYBACK_ENABLED=true
# Rate limiting: refill interval in ms for CDX requests (default: 12000).
# WAYBACK_RATE_LIMIT_INTERVAL_MS=12000
# Rate limiting: max tokens (burst capacity) for Wayback CDX requests.
# WAYBACK_RATE_LIMIT_TOKENS=5
# Per-domain timeout in ms for a single CDX API call.
# WAYBACK_TIMEOUT_MS=10000
#
# [WHOIS]
# Maximum concurrent WHOIS lookups per pipeline stage run.
# WHOIS_BATCH_CONCURRENCY=3
# Per-query timeout in milliseconds for WHOIS lookups.
# WHOIS_PER_QUERY_TIMEOUT_MS=10000
#
# [WORKER]
# Maximum number of jobs processed concurrently by the worker.
# WORKER_CONCURRENCY=2
# Enable the in-process job worker.
# WORKER_ENABLED=true

# --- Email (optional) ---
#
# SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587
# (smtps:// for implicit TLS). Used for team invitations and the email alert
# channel. Unset = email is disabled; invitations still return a copyable link.
# SMTP_URL=
# From header for outbound email.
# SMTP_FROM=DOMINUS <noreply@localhost>
# Comma-separated recipients of renewal/system alerts on the email channel
# (needs SMTP_URL).
# NOTIFIER_EMAIL_TO=ops@example.com

# --- SSO sign-in (AUTH_PROVIDER=auth0 with OIDC client credentials) ---
#
# Create a tenant (free plan, user as admin) the first time an SSO user with no
# team seat signs in. Opt-in (default false): enable for self-serve Cloud signup;
# leave off for a private SSO deployment, where users are invited instead.
# A user who accepts an invitation lands in that team on their next sign-in
# (most recently joined team wins).
# OIDC_AUTO_PROVISION_TENANTS=false
