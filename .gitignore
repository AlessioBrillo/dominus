*.sqlite
data/

# --- Claude runtime ---
.claude/scheduled_tasks.lock

# --- Stray migration rollback locks ---
# A rollback tool once wrote its lock file to the repository's parent
# directory (a literal `..locks/`), which git then committed as a tracked
# path outside the project root. Ignore it wherever it reappears.
..locks/
*/..locks/
**/..locks/

# --- Local agent harness config ---
.opencode/

# --- Coverage check snapshot (stale copies, do not commit) ---
coverage-check/

# --- Temporary alignment documents (do not commit) ---
dominus-business-plan.md
dominus-conversion-features-spec.md
*.paper.md

# Vitest benchmark output
bench-results.json

# --- Playwright E2E ---
.e2e/
playwright-report/
test-results/

# --- Cloud acceptance suite (fixtures hold live API keys) ---
.acceptance/
.acceptance-run*.log

