#cloud-config
# DOMINUS Cloud — app-node (api + worker + scheduler + redis + Caddy,
# consensus-dns, monitoring). Rendered by Terraform from module inputs;
# no secrets in the repo.
package_update: true
packages:
  - docker.io
  - docker-compose-plugin
  - fail2ban

write_files:
  # fail2ban jail for SSH: the public firewall admits ssh from the
  # operator CIDRs (or anywhere, keys only); brute force is throttled
  # here rather than in the firewall.
  - path: /etc/fail2ban/jail.d/dominus-sshd.local
    content: |
      [sshd]
      enabled = true
      maxretry = 3
      bantime = 1h
      findtime = 10m
      backend = systemd
    permissions: "0644"

  # Keys-only SSH, explicitly. sshd_config.d drop-ins are included before
  # the rest of the main config, and sshd honours the FIRST obtained
  # value, so this override wins regardless of the distro default.
  - path: /etc/ssh/sshd_config.d/99-dominus.conf
    content: |
      PasswordAuthentication no
      PermitRootLogin prohibit-password
    permissions: "0644"

  - path: /opt/dominus/.env
    content: |
      # Rendered by Terraform — do not edit by hand.
      # App connects as dominus_app (RLS-scoped, ADR-0038) — never the
      # owner role, which would bypass FORCE ROW LEVEL SECURITY.
      # sslmode=require: the db node serves hostssl-only connections
      # (self-signed cert on the private network), so plaintext is
      # refused at the server, not just discouraged at the client.
      DOMINUS_IMAGE_TAG=${image_tag}
      DATABASE_URL=postgres://dominus_app:${db_app_password}@${db_host}:5432/dominus?sslmode=require
      REDIS_URL=redis://redis:6379
      BACKUP_DIR=/backups
      WORKER_ENABLED=true
      SCHEDULER_ENABLED=true
      HOST=0.0.0.0
      PORT=3000
      %{ for k, v in app_env ~}
      ${k}=${v}
      %{ endfor ~}
    permissions: "0600"

  - path: /opt/dominus/docker-compose.yml
    content: |
      # DOMINUS Cloud app node (v1.0.0). Rendered by Terraform.
      # The ghcr image tags reference the DOMINUS_IMAGE_TAG env var from
      # .env at runtime (docker compose interpolation): a release bump is a
      # single .env edit + pull + roll via the deploy pipeline, never a
      # Terraform apply (which would recreate the node and lose named
      # volumes).
      name: dominus
      services:
        api:
          image: ghcr.io/alessiobrillo/dominus:$${DOMINUS_IMAGE_TAG}
          restart: unless-stopped
          env_file: /opt/dominus/.env
          environment:
            - DNS_CONSENSUS_ENABLED=true
            - DNS_CONSENSUS_NAMESERVERS=172.20.0.10:5300
          ports: ["127.0.0.1:3000:3000"]
          depends_on: [redis, consensus-dns]
          networks: [default, dns-consensus-net]
          healthcheck:
            test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)})"]
            interval: 30s
            timeout: 5s
            retries: 3
        worker:
          image: ghcr.io/alessiobrillo/dominus:$${DOMINUS_IMAGE_TAG}-worker
          restart: unless-stopped
          env_file: /opt/dominus/.env
          environment:
            - DNS_CONSENSUS_ENABLED=true
            - DNS_CONSENSUS_NAMESERVERS=172.20.0.10:5300
          volumes:
            - backups:/backups
          depends_on: [redis, consensus-dns]
          networks: [default, dns-consensus-net]
        scheduler:
          image: ghcr.io/alessiobrillo/dominus:$${DOMINUS_IMAGE_TAG}-scheduler
          restart: unless-stopped
          env_file: /opt/dominus/.env
          environment:
            - DNS_CONSENSUS_ENABLED=true
            - DNS_CONSENSUS_NAMESERVERS=172.20.0.10:5300
          volumes:
            - backups:/backups
          depends_on: [redis, consensus-dns]
          networks: [default, dns-consensus-net]
        redis:
          image: redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
          restart: unless-stopped
          command: ["redis-server", "--appendonly", "yes"]
          volumes: [redis-data:/data]
        consensus-dns:
          image: mvance/unbound@sha256:76906da36d1806f3387338f15dcf8b357c51ce6897fb6450d6ce010460927e90
          restart: unless-stopped
          networks:
            dns-consensus-net:
              ipv4_address: 172.20.0.10
          volumes:
            - ./unbound/unbound.conf:/opt/unbound/unbound.conf:ro
          command: ["-d", "-c", "/opt/unbound/unbound.conf"]
          healthcheck:
            test: ["CMD", "unbound-control", "status"]
            interval: 15s
            timeout: 5s
            retries: 5
        redis-exporter:
          image: oliver006/redis_exporter:v1.64.0@sha256:164814f4fb1455eb96a303a7fe4cebe0f6db62ae533c167adc97be6e04e94bc3
          restart: unless-stopped
          command: ["--check-keys", "--redis.addr=redis://redis:6379"]
          depends_on: [redis]
        prometheus:
          image: prom/prometheus:v2.53.1@sha256:f20d3127bf2876f4a1df76246fca576b41ddf1125ed1c546fbd8b16ea55117e6
          restart: unless-stopped
          command:
            - --config.file=/etc/prometheus/prometheus.yml
            - --storage.tsdb.path=/prometheus
            - --storage.tsdb.retention.time=30d
            - --web.enable-lifecycle
          volumes:
            - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
            - ./prometheus/rules.yml:/etc/prometheus/rules.yml:ro
            - prometheus-data:/prometheus
          %{ if metrics_token_set ~}
            - ./prometheus/metrics-token:/etc/prometheus/metrics-token:ro
          %{ endif ~}
          depends_on: [api]
        alertmanager:
          image: prom/alertmanager:v0.27.0@sha256:e13b6ed5cb929eeaee733479dce55e10eb3bc2e9c4586c705a4e8da41e5eacf5
          restart: unless-stopped
          command:
            - --config.file=/etc/alertmanager/alertmanager.yml
            - --storage.path=/alertmanager
          volumes:
            - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
            - alertmanager-data:/alertmanager
        caddy:
          image: caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
          restart: unless-stopped
          ports: ["80:80", "443:443", "443:443/udp"]
          volumes:
            - ./Caddyfile:/etc/caddy/Caddyfile:ro
            - caddy-data:/data
            - caddy-config:/config
          depends_on: [api]
      networks:
        dns-consensus-net:
          driver: bridge
          ipam:
            config:
              - subnet: 172.20.0.0/24
      volumes:
        redis-data:
        backups:
        caddy-data:
        caddy-config:
        prometheus-data:
        alertmanager-data:
    permissions: "0644"

  - path: /opt/dominus/unbound/unbound.conf
    content: |
${indent(6, unbound_conf)}
    permissions: "0644"

  - path: /opt/dominus/prometheus/prometheus.yml
    content: |
${indent(6, prometheus_yml)}
    permissions: "0644"

  %{ if metrics_token_set ~}
  - path: /opt/dominus/prometheus/metrics-token
    content: |
${indent(6, metrics_token)}
    permissions: "0600"
  %{ endif ~}

  - path: /opt/dominus/prometheus/rules.yml
    content: |
${indent(6, rules_yml)}
    permissions: "0644"

  - path: /opt/dominus/alertmanager/alertmanager.yml
    content: |
${indent(6, alertmanager_yml)}
    permissions: "0644"

  - path: /opt/dominus/Caddyfile
    content: |
      # DOMINUS Cloud — reverse proxy (TLS via Let's Encrypt).
      %{ if domain != "" }
      ${domain} {
        reverse_proxy api:3000
        encode gzip
      }
      %{ else }
      :80 {
        reverse_proxy api:3000
      }
      %{ endif }
    permissions: "0644"

  - path: /etc/systemd/system/dominus-compose.service
    content: |
      [Unit]
      Description=DOMINUS Cloud compose stack
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=/opt/dominus
      ExecStart=/usr/bin/docker compose up -d --pull always
      ExecStop=/usr/bin/docker compose down
      TimeoutStartSec=300

      [Install]
      WantedBy=multi-user.target
    permissions: "0644"

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now dominus-compose.service
  - docker compose -f /opt/dominus/docker-compose.yml version
  - systemctl enable --now fail2ban
  # Apply the keys-only SSH posture written above.
  - systemctl restart ssh