#cloud-config
# DOMINUS Cloud — db-node (PostgreSQL 17 + PITR, ADR-0054).
# Rendered by Terraform from module inputs; no secrets in the repo.
package_update: true
packages:
  - postgresql-17
  - rclone

write_files:
  # Secrets for the daily PITR cron live here (0600) instead of inline in
  # the cron file under /etc/cron.d (which cron treats as 0644 and any
  # local user could read). The cron line sources this file; nothing
  # sensitive is written to the cron file itself.
  - path: /opt/dominus/backup.env
    content: |
      PG_HOST=127.0.0.1
      PG_PORT=5432
      PG_USER=backup
      PG_PASSWORD=${db_backup_password}
      BACKUP_DIR=/var/lib/postgresql/backups
      PG_BASE_RETENTION_DAYS=14
      WAL_RETENTION_DAYS=7
      %{ if b2_enabled }
      B2_BASE_REMOTE=b2:${b2_bucket}/base/
      B2_WAL_REMOTE=b2:${b2_bucket}/wal/
      %{ endif }
    permissions: "0600"

  %{ if b2_enabled }
  # rclone config lives in the postgres user's HOME so both the WAL
  # archiver (postgres server process) and the backup cron can use it.
  # Ownership is applied in runcmd: write_files runs before the package
  # install creates the postgres user, so an owner here would silently
  # not apply.
  - path: /var/lib/postgresql/.config/rclone/rclone.conf
    content: |
      [b2]
      type = b2
      account = ${b2_account_id}
      key = ${b2_app_key}
      endpoint = ${b2_endpoint}
    permissions: "0600"
  %{ endif }

  # ADR-0054 PITR wiring. With archive_mode=on but no reachable archive the
  # WAL archiver stalls the node — so the archive is only enabled when B2
  # credentials were provided.
  - path: /etc/postgresql/17/main/conf.d/dominus-pitr.conf
    content: |
      %{ if b2_enabled }
      wal_level = replica
      archive_mode = on
      archive_command = 'test ! -f /var/lib/postgresql/backups/wal/%f && rclone copy %p b2:${b2_bucket}/wal/%f'
      archive_timeout = 300
      %{ else }
      wal_level = replica
      archive_mode = off
      %{ endif }
    permissions: "0644"

runcmd:
  - mkdir -p /var/lib/postgresql/backups/wal
  - chown -R postgres:postgres /var/lib/postgresql/backups
  # The PITR cron appends to /var/log/dominus/base-backup.log as the
  # postgres user; the directory must exist and be postgres-owned or the
  # daily job fails on the very first redirect.
  - mkdir -p /var/log/dominus
  - chown postgres:postgres /var/log/dominus
  # rclone.conf is written root-owned (write_files runs before the
  # postgres user exists); the WAL archiver and backup cron run as
  # postgres, so fix ownership after the package install.
  - chown -R postgres:postgres /var/lib/postgresql/.config
  - |
    sudo -u postgres psql -v ON_ERROR_STOP=1 <<EOSQL
    DO \$\$ BEGIN
      IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'dominus') THEN
        CREATE ROLE dominus LOGIN PASSWORD '${db_password}';
      END IF;
      IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'backup') THEN
        CREATE ROLE backup LOGIN REPLICATION PASSWORD '${db_backup_password}';
      END IF;
      IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'dominus_app') THEN
        CREATE ROLE dominus_app LOGIN PASSWORD '${db_app_password}';
      END IF;
    END \$\$;
    SELECT 'CREATE DATABASE dominus OWNER dominus'
    WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'dominus')\gexec
    GRANT ALL PRIVILEGES ON DATABASE dominus TO dominus;
    -- The app must NOT connect as the owner: owner roles bypass FORCE ROW
    -- LEVEL SECURITY (migration 0047), so tenant isolation would silently
    -- rest on application-level filters alone (ADR-0038). Mirror
    -- deploy/postgres/init-app-role.sh; default privileges make every
    -- table/sequence created later by migrations app-accessible.
    GRANT CONNECT ON DATABASE dominus TO dominus_app;
    GRANT USAGE ON SCHEMA public TO dominus_app;
    GRANT CREATE ON SCHEMA public TO dominus_app;
    GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO dominus_app;
    ALTER DEFAULT PRIVILEGES IN SCHEMA public
      GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO dominus_app;
    GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO dominus_app;
    ALTER DEFAULT PRIVILEGES IN SCHEMA public
      GRANT USAGE, SELECT ON SEQUENCES TO dominus_app;
    EOSQL
  - |
    if ! grep -q "10.0.0.0/16" /etc/postgresql/17/main/pg_hba.conf; then
      cat >> /etc/postgresql/17/main/pg_hba.conf <<EOF
    # DOMINUS app node (private network)
    host all dominus 10.0.0.0/16 scram-sha-256
    host all dominus_app 10.0.0.0/16 scram-sha-256
    host all backup 10.0.0.0/16 scram-sha-256
    EOF
    fi
  - sed -i "s/^#listen_addresses.*/listen_addresses = '*'/" /etc/postgresql/17/main/postgresql.conf
  - systemctl restart postgresql
  # Canonical backup script from the repo at the pinned deploy tag — no
  # drift from an embedded copy (immutable supply chain, ADR-0046).
  - curl -fsSL -o /opt/dominus/base-backup.sh \
      https://raw.githubusercontent.com/AlessioBrillo/dominus/${image_tag}/deploy/postgres/base-backup.sh
  # The cron runs the script as the postgres user: it must be
  # postgres-owned and not world-readable (it carries no secrets itself —
  # those live in backup.env — but stays 0700 as a hard boundary).
  - chown postgres:postgres /opt/dominus/base-backup.sh
  - chmod 0700 /opt/dominus/base-backup.sh
  %{ if b2_enabled }
  - |
    cat > /etc/cron.d/dominus-pitr <<EOF
    30 4 * * * postgres set -a; . /opt/dominus/backup.env; set +a; /opt/dominus/base-backup.sh >> /var/log/dominus/base-backup.log 2>&1
    EOF
  %{ endif }