# Copy to terraform.tfvars and fill in real values. Never commit
# terraform.tfvars — it contains the Hetzner token and DB credentials.

hcloud_token      = "REPLACE_WITH_HETZNER_API_TOKEN"
ssh_public_key    = "ssh-ed25519 AAAA... operator@host"
domain            = "app.dominus.example"
# The image tag is written into the app node's DOMINUS_IMAGE_TAG at first
# provision. It must name a RELEASED tag, and there is deliberately NO
# default in main.tf: a default is a release frozen at the time the file was
# written, and the v1.3.0 tree still defaulted to v1.2.0 — a first apply
# booted the previous release's image. A stale tag also rolls the node back
# onto an old image, which the migration gate then refuses at boot (schema
# ahead of image).
#
# Bump this at every release. `npm run check:release-consistency` fails the
# build when it disagrees with package.json.
image_tag         = "v1.3.3"   # must name a RELEASED tag; bump per deploy

# SSH ingress allowlist (both nodes). The default is EMPTY and an apply
# with an empty allowlist is refused by a precondition on both firewalls:
# an SSH port open to the whole internet is a standing invitation, and a
# permissive default survives longer than a documented one. Pick one:
#
#   A. the operator's own networks (recommended once the deploy runner
#      has a static egress IP):
#   ssh_allowed_cidrs = ["203.0.113.10/32"]
#
#   B. the explicit opt-in — SSH from any address. The nodes are
#      key-only (PasswordAuthentication no) and fail2ban throttles the
#      guessing, but a compromised operator key becomes world-reachable.
#   allow_public_ssh = true
#
# Caveat: the release pipeline (deploy.yml) reaches the app node over SSH
# from GitHub Actions runners with dynamic egress IPs — a static-egress
# runner is required before the app node can be restricted. The db node
# can be restricted freely.

db_password       = "REPLACE_WITH_STRONG_DB_PASSWORD"
# Dedicated password for the backup role (REPLICATION only, used by the
# daily PITR cron via /opt/dominus/backup.env on the db node — never the
# owner password, so a single file leak can't escalate).
db_backup_password = "REPLACE_WITH_STRONG_BACKUP_PASSWORD"
# App connection role password (RLS-scoped dominus_app, ADR-0038/0047).
db_app_password   = "REPLACE_WITH_STRONG_APP_PASSWORD"

# Alertmanager webhook URL. Replaces the example.com placeholder in the
# alertmanager.yml rendered onto the app node. SET THIS: example.com resolves
# and answers 200 to any POST, so leaving it unset deploys a stack that looks
# healthy and never delivers an alert. Keep the same endpoint as
# NOTIFIER_WEBHOOK_URL below for a single alert inbox.
alertmanager_webhook_url = "https://hooks.example/REPLACE-WITH-YOUR-ALERT-ENDPOINT"

# Hetzner DNS (optional): when set, the app A record is created at apply
# time in the given zone (must exist in Hetzner DNS). Leave empty to point
# an external registrar's A record at app_public_ip manually.
# hetzner_dns_token = "REPLACE_WITH_HETZNER_DNS_TOKEN"
# dns_zone_name     = "dominus.example"

app_env = {
  # Managed identity (DOMINUS Cloud): database-backed API keys, tenant auto
  # provisioning and usage enforcement are forced ON by AUTH_PROVIDER=db.
  AUTH_PROVIDER            = "db"
  AUTO_PROVISION_TENANTS   = "true"
  USAGE_ENFORCEMENT_ENABLED = "true"
  # API_KEYS belongs to AUTH_PROVIDER=env (the community edition, one
  # operator, one static key). In db mode it is NOT the key material: the
  # Cloud keys live in the api_keys table, hashed with scrypt, and are
  # minted on the node after the first boot:
  #
  #   docker compose exec api node dist/cli.js keys create \
  #     --tenant <tenant-id> --name ops --role admin
  #
  # Setting API_KEYS here would look like it works and authenticate nobody.
  #
  # JWT_SECRET is not read by the application at all: ADR-0017 chose opaque
  # API keys over JWT bearer tokens. Setting it here would be theatre.
  #
  # Stripe keys (billing). Use TEST keys in staging and LIVE keys only in
  # production: a live key in a staging environment is a live key with a
  # staging blast radius.
  STRIPE_SECRET_KEY      = "sk_test_REPLACE_ME"
  STRIPE_PUBLISHABLE_KEY = "pk_test_REPLACE_ME"
  STRIPE_WEBHOOK_SECRET  = "whsec_REPLACE_ME"
  STRIPE_PRICE_ID_PRO_MONTHLY      = "price_xxx"
  STRIPE_PRICE_ID_PRO_YEARLY       = "price_xxx"
  STRIPE_PRICE_ID_TEAM_MONTHLY     = "price_xxx"
  STRIPE_PRICE_ID_TEAM_YEARLY      = "price_xxx"
  STRIPE_PRICE_ID_ENTERPRISE_MONTHLY = "price_xxx"
  STRIPE_PRICE_ID_ENTERPRISE_YEARLY  = "price_xxx"
  # Prometheus scrape token (protects /api/v1/metrics/*; uncomment the
  # authorization block in deploy/prometheus/prometheus.yml to match).
  METRICS_TOKEN = "REPLACE_WITH_METRICS_TOKEN"
  # Alert webhook (dead-letter notifications; alertmanager.yml on the node
  # routes the same endpoint). Left unset on purpose: an example.com
  # placeholder resolves and returns 200 to any POST, so every alert is
  # silently swallowed. Set a real endpoint, or leave it empty and rely on
  # Prometheus/Alertmanager plus `dominus maintenance` output instead.
  # NOTIFIER_WEBHOOK_URL = "https://hooks.slack.com/services/REPLACE/WITH/REAL"
  # Trade API keys as needed; secrets stay out of git.
}

# PITR WAL archive to Backblaze B2 (ADR-0054). Enabled by default: an apply
# without these credentials fails loudly (precondition). Only a deliberate,
# documented exception disables it — without the off-host archive a db-node
# loss is total data loss.
b2_backup = {
  enabled         = true
  bucket          = "dominus-pitr"
  account_id      = "REPLACE_WITH_B2_KEY_ID"
  application_key = "REPLACE_WITH_B2_APPLICATION_KEY"
  endpoint        = "https://s3.eu-central-003.backblazeb2.com"
}